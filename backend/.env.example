# Salin ke .env lalu isi nilainya. .env TIDAK di-commit.
# Dibaca otomatis oleh app/config.py (tanpa --env-file). Env shell menang atas file ini,
# jadi di hosting cukup isi Variables dashboard.
# Tanda: [wajib] tanpa nilai backend tetap boot tapi fitur DB/berita mati.

# --- Supabase [wajib] ---
# Project Settings -> API -> Project URL (format https://<ref>.supabase.co)
SUPABASE_URL=
# Project Settings -> API -> service_role secret. RAHASIA: bypass RLS.
# JANGAN taruh di frontend atau bot.
SUPABASE_SERVICE_ROLE_KEY=

# --- Mode aplikasi [wajib di produksi] ---
# development | production. production = endpoint bot tanpa X-API-Key dibalas 503.
APP_ENV=development

# --- CORS [wajib] ---
# Origin frontend, pisahkan dengan koma (tanpa trailing slash).
# Lokal: http://localhost:3000 — Produksi: https://<domain-frontend>
GUARDIANAI_CORS_ORIGINS=http://localhost:3000

# --- Discord Bot (Agent-RJ) ---
# Rahasia service-to-service (header X-API-Key). Nilai yang sama juga dipakai bot
# (REDJOHN_API_KEY) dan route handler frontend (DISCORD_BOT_API_KEY).
# Kosong + development = endpoint bot terbuka. Kosong + production = 503.
# Produksi: isi acak >= 32 karakter.
DISCORD_BOT_API_KEY=

# --- Admin kuis ---
# Tidak ada env admin. Role admin ada di kolom public.profiles.role (migrasi
# 007_profiles.sql). Promote: Supabase Table Editor -> profiles -> ubah role
# menjadi 'admin'. Berlaku tanpa restart backend.

# --- News harvester ---
# Scheduler hanya hidup di proses scraper. Jalankan terpisah:
#   uv run scraper.py
# true = API (`uv run main.py`) ikut menjalankan scheduler (deploy satu container).
NEWS_SCHEDULER=false
# true = jalankan satu putaran harvest langsung saat boot (bukan tunggu interval)
NEWS_RUN_ON_START=false
# Jarak antar harvest (jam)
NEWS_INTERVAL_HOURS=6

# --- Broadcast berita Discord ---
# true = API mengantrikan 5 berita acak ke semua guild dengan channel berita/alert
# pada 05:00, 13:00, dan 20:00 WITA. Aktifkan di SATU proses backend saja.
NEWS_BROADCAST_SCHEDULER=false

# --- Klasemen kuis harian ---
# true = API menjalankan cron pengumuman klasemen ke semua guild terdaftar.
# PRASYARAT: migrasi 008 + bot Agent-RJ versi baru sudah ter-deploy.
# Bot lama akan memperlakukan job kind="leaderboard" sebagai berita acak.
LEADERBOARD_SCHEDULER=false
# Jam WIB pengumuman sekaligus reset periode (0-23).
# Periode = [hari ini HH:00, besok HH:00) WIB.
LEADERBOARD_HOUR=21

# --- Port ---
# Dipakai CMD Dockerfile. Hosting biasanya menyuntikkan PORT sendiri.
# PORT=8000

# --- OpenRouter (generate soal kuis AI) ---
# Dipakai tombol "Generate Soal Hari Ini" di /admin tab Kuis.
# https://openrouter.ai/keys — RAHASIA: hanya dipakai backend, jangan taruh di frontend.
OPENROUTER_API_KEY=
# Model default untuk generate soal. Model gratis (suffix ":free"), 1M context.
# Alternatif: dots-studio/dots-3-note-preview:free (output 460k).
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
